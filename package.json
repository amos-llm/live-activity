{
  "name": "live-activity",
  "version": "0.0.0",
  "private": true,
  "description": "Live shell output and a one-line live view of thinking in the Paseo timeline",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "client/",
    "shared/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.2",
    "@types/react": "~19.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
